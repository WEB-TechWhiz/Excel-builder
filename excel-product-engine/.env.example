# No secrets are required by the core engine.
# Reserved for future needs and the optional LLM bridge (pip install -e ".[llm]").

EXCEL_ENGINE_OUTPUT_DIR=output
EXCEL_ENGINE_LOG_LEVEL=INFO
EXCEL_ENGINE_DEBUG=false

# Optional — only needed for excel_engine.llm (natural-language workbook generation)
ANTHROPIC_API_KEY=
EXCEL_ENGINE_LLM_MODEL=claude-haiku-4-5-20251001
